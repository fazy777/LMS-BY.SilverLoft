# ==========================================
# LMS Application Environment Variables
# ==========================================
# For Local Development: copy to .env.local
# For Vercel Deployment: add these in Vercel Dashboard -> Settings -> Environment Variables

# --- 1. App URL ---
# Locally: http://localhost:3000
# On Vercel: https://your-project-name.vercel.app
NEXT_PUBLIC_APP_URL=https://your-project-name.vercel.app

# --- 2. Client-Side Firebase (Accessible in Browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- 3. Server-Side Firebase Admin ---
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Paste the exact private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- 4. MySQL Database (Cloud Hosted for Vercel) ---
# NOTE: Vercel serverless functions CANNOT connect to localhost.
# Use a cloud MySQL provider such as TiDB Cloud, Aiven, Railway, AWS RDS, or PlanetScale.
# Option A: Single Connection URI
DATABASE_URL=mysql://username:password@hostname:3306/database_name

# Option B: Individual Connection Parameters
MYSQL_HOST=your-cloud-db-host.com
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=LMS
MYSQL_CONNECTION_LIMIT=5
MYSQL_SSL=true

# --- 5. Resend (Email Verification & Notifications) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=LMS Support <onboarding@resend.dev>

# --- 6. Stripe (Payments & Connect Payouts) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
PLATFORM_FEE_BPS=0

# --- 7. Cloudflare Stream / Cloudinary (Video & Media) ---
CLOUDFLARE_STREAM_ACCOUNT_ID=your_cloudflare_stream_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_STREAM_MAX_DURATION_SECONDS=3600

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
